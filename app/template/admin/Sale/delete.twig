{% extends '@admin/default_frame.twig' %}

{% set menus = ['sale', 'sale'] %}

{% block title %}{{ 'admin.sale.delete.title'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.sale.delete.sub_title'|trans }}{% endblock %}

{% block main %}
    <form name="form1" method="post" action="{{ url('admin_sale_delete_confirm', { id: Sale.id }) }}">
        {{ form_widget(form._token) }}
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col">
                                    <div class="d-inline-block" data-tooltip="true" data-placement="top" title="{{ 'admin.sale.delete.tooltip'|trans }}">
                                        <span class="card-title">{{ 'admin.sale.delete.header'|trans }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row mb-2">
                                <div class="col">
                                    <p class="mb-4">
                                        {{ 'admin.sale.delete.confirm_message'|trans({'%name%': Sale.title}) }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem">
                            <a class="c-baseLink" href="{{ url('admin_sale') }}">
                                <i class="fa fa-backward" aria-hidden="true"></i>
                                <span>{{ 'admin.sale.list.title'|trans }}</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                <button class="btn btn-ec-delete" type="submit">
                                    {{ 'admin.common.delete'|trans }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
