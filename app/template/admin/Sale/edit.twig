{% extends '@admin/default_frame.twig' %}

{% set menus = ['sale', 'sale'] %}

{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('assets/css/tempusdominus-bootstrap-4.min.css', 'admin') }}">
{% endblock %}

{% block javascript %}
    <script src="{{ asset('assets/js/vendor/moment.min.js', 'admin') }}"></script>
    <script src="{{ asset('assets/js/vendor/moment-with-locales.min.js', 'admin') }}"></script>
    <script src="{{ asset('assets/js/vendor/tempusdominus-bootstrap-4.min.js', 'admin') }}"></script>
    <script>
        $(function() {
            // Initialize date picker for form fields with class 'datepicker'
            $('.datepicker, input[data-toggle="datepicker"]').datetimepicker({
                locale: 'ja',
                format: 'YYYY-MM-DD HH:mm',
                showTodayButton: true,
                showClose: true,
                stepping: 5,
                sideBySide: true,
                toolbarPlacement: 'top',
                buttons: {
                    showToday: true,
                    showClose: true
                },
                icons: {
                    time: 'far fa-clock',
                    date: 'far fa-calendar-alt',
                    up: 'fas fa-arrow-up',
                    down: 'fas fa-arrow-down',
                    previous: 'fas fa-arrow-left',
                    next: 'fas fa-arrow-right',
                    today: 'far fa-calendar-check',
                    clear: 'far fa-trash-alt',
                    close: 'fas fa-times'
                }
            });
        });
    </script>
{% endblock %}

{% block title %}{{ 'admin.sale.edit.title'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.sale.edit.sub_title'|trans }}{% endblock %}

{% block main %}
    <form name="form1" role="form" class="form-horizontal h-adr" id="sale_form" method="post" action="{{ path('admin_sale_edit', {'id': Sale.id}) }}">
        {{ form_widget(form._token) }}
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-8">
                                    <div class="d-inline-block" data-tooltip="true" data-placement="top" title="{{ 'admin.sale.edit.tooltip'|trans }}">
                                        <span class="card-title">{{ 'admin.sale.edit.header'|trans }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-3">
                                    <div class="d-inline-block" data-tooltip="true" data-placement="top" title="{{ 'admin.sale.title.tooltip'|trans }}">
                                        <span>{{ 'admin.sale.label.title'|trans }}</span>
                                        <span class="badge badge-primary ml-1">{{ 'admin.common.required'|trans }}</span>
                                    </div>
                                </div>
                                <div class="col mb-2">
                                    {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'admin.sale.title.placeholder'|trans}}) }}
                                    {{ form_errors(form.title) }}
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-3">
                                    <div class="d-inline-block" data-tooltip="true" data-placement="top" title="{{ 'admin.sale.description.tooltip'|trans }}">
                                        <span>{{ 'admin.sale.label.description'|trans }}</span>
                                    </div>
                                </div>
                                <div class="col mb-2">
                                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 8}}) }}
                                    {{ form_errors(form.description) }}
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-3">
                                    <div class="d-inline-block" data-tooltip="true" data-placement="top" title="{{ 'admin.sale.discount_type.tooltip'|trans }}">
                                        <span>{{ 'admin.sale.label.discount_type'|trans }}</span>
                                        <span class="badge badge-primary ml-1">{{ 'admin.common.required'|trans }}</span>
                                    </div>
                                </div>
                                <div class="col mb-2">
                                    {{ form_widget(form.discount_type, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.discount_type) }}
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-3">
                                    <div class="d-inline-block" data-tooltip="true" data-placement="top" title="{{ 'admin.sale.discount_amount.tooltip'|trans }}">
                                        <span>{{ 'admin.sale.label.discount_amount'|trans }}</span>
                                        <span class="badge badge-primary ml-1">{{ 'admin.common.required'|trans }}</span>
                                    </div>
                                </div>
                                <div class="col mb-2">
                                    {{ form_widget(form.discount_amount, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.discount_amount) }}
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-3">
                                    <div class="d-inline-block" data-tooltip="true" data-placement="top" title="{{ 'admin.sale.period.tooltip'|trans }}">
                                        <span>{{ 'admin.sale.label.period'|trans }}</span>
                                        <span class="badge badge-primary ml-1">{{ 'admin.common.required'|trans }}</span>
                                    </div>
                                </div>
                                <div class="col mb-2">
                                    <div class="row align-items-center">
                                        <div class="col">
                                            {{ form_widget(form.from_date) }}
                                            {{ form_errors(form.from_date) }}
                                        </div>
                                        <div class="col-auto text-center">
                                            <span class="align-middle">～</span>
                                        </div>
                                        <div class="col">
                                            {{ form_widget(form.to_date) }}
                                            {{ form_errors(form.to_date) }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-3">
                                    <div class="d-inline-block" data-tooltip="true" data-placement="top" title="{{ 'admin.sale.visible.tooltip'|trans }}">
                                        <span>{{ 'admin.sale.label.visible'|trans }}</span>
                                        <span class="badge badge-primary ml-1">{{ 'admin.common.required'|trans }}</span>
                                    </div>
                                </div>
                                <div class="col mb-2">
                                    {{ form_widget(form.visible, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.visible) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem">
                            <a class="c-baseLink" href="{{ path('admin_sale') }}">
                                <i class="fa fa-backward" aria-hidden="true"></i>
                                <span>{{ 'admin.sale.list.title'|trans }}</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                <button class="btn btn-ec-conversion px-5" type="submit">{{ 'admin.content.file.updated'|trans }}</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
